---
import Base from '../layouts/Base.astro';
import CartTotals from '../components/CartTotals.astro';
import { cart, checkout as t, common } from '../i18n/pl';
import { MAX_UNITS_PER_ORDER, type Field } from '../lib/checkout';
import { fill } from '../lib/i18n';
import { SITE } from '../lib/site';
import { STORAGE_KEY } from '../scripts/cart-store';

// Token Geowidgetu z Managera Paczek InPost (zmienna buildu). Bez tokenu - pole na kod paczkomatu.
const geoToken = import.meta.env.PUBLIC_INPOST_GEOWIDGET_TOKEN ?? '';
// API zamówień i płatności (Worker, zwykle `/api/orders`). Bez niego - podsumowanie do wysłania na Instagramie.
const endpoint = import.meta.env.PUBLIC_CHECKOUT_ENDPOINT ?? '';
// Cloudflare Turnstile („nie jestem robotem”) - klucz strony z panelu Cloudflare; sekret: TURNSTILE_SECRET w Workerze.
const turnstileKey = endpoint ? (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '') : '';

const ERRORS: Record<Field, string> = { name: t.nameError, email: t.emailError, phone: t.phoneError, locker: t.lockerError, terms: t.termsError };
// Teksty potrzebne skryptowi strony - osadzone tutaj, a nie importowane w JS (mniejsza wspólna paczka).
const clientTexts = {
  text: t.text, free: cart.free, submitting: t.submitting, submitPay: t.submitPay, submitError: t.submitError,
  errorRef: t.errorRef, stockError: t.stockError, rateLimited: t.rateLimited, lockerNotFound: t.lockerNotFound,
  pendingLimit: t.pendingLimit, captchaError: t.captchaError, tooManyItems: fill(t.tooManyItems, { max: MAX_UNITS_PER_ORDER }),
  copied: t.copied, copyFailed: t.copyFailed, lockerSelected: t.lockerSelected,
};
export type ClientTexts = typeof clientTexts;

const fields = [
  { name: 'name', label: t.name, type: 'text', autocomplete: 'name' },
  { name: 'email', label: t.email, type: 'email', autocomplete: 'email', inputmode: 'email', hint: t.emailHint },
  { name: 'phone', label: t.phone, type: 'tel', autocomplete: 'tel', inputmode: 'tel', hint: t.phoneHint },
] as const;
---
<Base title={t.metaTitle} noindex>
  <section class="container section--tight">
    <h1>{t.title}</h1>

    <script is:inline define:vars={{ key: STORAGE_KEY }}>
      /* Przed pierwszym renderem: pusty koszyk → od razu komunikat, bez przeskoku układu (CLS). */
      try { if (!(JSON.parse(localStorage.getItem(key) || '[]') || []).length) document.documentElement.classList.add('co-empty'); }
      catch (e) { document.documentElement.classList.add('co-empty'); }
    </script>

    <div class="empty" data-co-empty hidden>
      <p class="t-lead">{cart.emptyLead}</p>
      <a class="btn" href="/sklep/">{common.goToShop}</a>
    </div>

    <div class="split split--top layout" style="--split: 1.4fr 1fr" data-co-main>
      <form novalidate data-co-form data-endpoint={endpoint}>
        <fieldset class="contact">
          <legend><span class="step">1</span> {t.stepContact}</legend>
          {fields.map((f) => (
            <div class="field" data-field={f.name}>
              <label for={`co-${f.name}`}>{f.label}</label>
              <input
                id={`co-${f.name}`}
                name={f.name}
                type={f.type}
                autocomplete={f.autocomplete}
                inputmode={'inputmode' in f ? f.inputmode : undefined}
                required
                aria-describedby={`co-${f.name}-err${'hint' in f ? ` co-${f.name}-hint` : ''}`}
              />
              {'hint' in f && <p class="hint" id={`co-${f.name}-hint`}>{f.hint}</p>}
              <p class="err" id={`co-${f.name}-err`} data-msg={ERRORS[f.name]}></p>
            </div>
          ))}
        </fieldset>

        <fieldset>
          <legend><span class="step">2</span> {t.stepDelivery}</legend>
          {geoToken && <button type="button" class="btn btn--ghost" data-geo-open>{t.mapOpen}</button>}
          <div class="field">
            <label for="co-locker">{t.locker}</label>
            <input id="co-locker" name="locker" required autocapitalize="characters" spellcheck="false" placeholder={t.lockerPlaceholder} aria-describedby="co-locker-err co-locker-hint" />
            <p class="hint" id="co-locker-hint" data-locker-hint>
              {geoToken ? t.lockerHintMap : <>{t.lockerHintBefore}<a href="https://inpost.pl/znajdz-paczkomat" target="_blank" rel="noopener">{t.lockerHintLink}</a>.</>}
            </p>
            <p class="err" id="co-locker-err" data-msg={ERRORS.locker}></p>
          </div>
        </fieldset>

        <fieldset>
          <legend><span class="step">3</span> {t.stepNotes}</legend>
          <label class="check"><input type="checkbox" name="gift" /><span>{t.gift} <span class="t-muted">{t.giftHint}</span></span></label>
          <div class="field">
            <label for="co-notes">{t.notes} <span class="t-muted">{t.optional}</span></label>
            <textarea id="co-notes" name="notes" rows="3"></textarea>
          </div>
        </fieldset>

        <label class="check">
          <input id="co-terms" type="checkbox" name="terms" required aria-describedby="co-terms-err" />
          <span>{t.termsBefore}<a href="/regulamin/" target="_blank">{t.termsLink}</a>{t.termsMiddle}<a href="/polityka-prywatnosci/" target="_blank">{t.privacyLink}</a>.</span>
        </label>
        <p class="err" id="co-terms-err" data-msg={ERRORS.terms}></p>

        {turnstileKey && <div class="cf-turnstile captcha" data-sitekey={turnstileKey} data-language="pl" data-appearance="interaction-only" data-size="flexible"></div>}
        <button class="btn btn--block btn--lg" type="submit" data-co-submit>{endpoint ? t.submitPay : t.submitPrepare}</button>
        {endpoint && <p class="t-small t-muted center">{t.payments}</p>}
      </form>

      <aside class="side" aria-labelledby="co-sum">
        <h2 id="co-sum" class="h3">{t.summary}</h2>
        <ul class="lines" role="list" data-co-lines><li aria-hidden="true">&nbsp;</li></ul>
        <CartTotals shippingLabel={t.lockerShipping} totalLabel={t.due} />
        <button type="button" class="link-btn" data-cart-open>{t.editCart}</button>
      </aside>
    </div>

    <div class="fallback" data-co-fallback hidden tabindex="-1">
      <h2>{t.fallbackTitle}</h2>
      <p class="t-lead">{t.fallbackLead}</p>
      <pre class="summary-text" data-co-text></pre>
      <div class="actions">
        <button type="button" class="btn btn--lg" data-co-copy>{t.copy}</button>
        <a class="btn btn--ghost btn--lg" href={SITE.instagram} target="_blank" rel="noopener">{common.openInstagram}</a>
      </div>
      <p class="t-small t-muted" aria-live="polite" data-co-copied></p>
    </div>
  </section>

  <script type="application/json" id="checkout-texts" set:html={JSON.stringify(clientTexts)} />
  {turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  {geoToken && (
    <dialog class="geo" data-geo aria-label={t.mapLabel}>
      <button type="button" class="icon-btn geo-close" data-geo-close aria-label={t.mapClose}>×</button>
      <div class="geo-map" data-geo-map data-token={geoToken}></div>
    </dialog>
  )}
</Base>

<script>
  import { FIELDS, normalizeLocker, normalizePhone, summaryText, validate, withinOrderLimits, type Field, type OrderForm } from '../lib/checkout';
  import { fill } from '../lib/i18n';
  import { formatGrosze } from '../lib/money';
  import { totals } from '../lib/pricing';
  import { CHANGE_EVENT, PENDING_ORDER_KEY, read, readConfig, sync } from '../scripts/cart-store';
  import { renderTotals } from '../scripts/cart-ui';

  const q = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const form = q<HTMLFormElement>('[data-co-form]');
  const cfg = readConfig();
  const t = JSON.parse(q('#checkout-texts').textContent ?? '{}') as import('./zamowienie.astro').ClientTexts;

  const cell = (text: string) => Object.assign(document.createElement('span'), { textContent: text });

  function render() {
    const items = read();
    const sum = totals(items, cfg);
    document.documentElement.classList.remove('co-empty');
    q('[data-co-empty]').hidden = items.length > 0;
    q('[data-co-main]').hidden = items.length === 0 || !q('[data-co-fallback]').hidden;
    q('[data-co-lines]').replaceChildren(
      ...items.map((i) => {
        const li = document.createElement('li');
        li.append(cell(`${i.name} × ${i.qty}`), cell(formatGrosze(i.price * i.qty)));
        return li;
      }),
    );
    renderTotals(document, sum);
    return { items, sum };
  }

  function readForm(): OrderForm {
    const d = new FormData(form);
    const str = (k: string) => String(d.get(k) ?? '');
    return { name: str('name'), email: str('email'), phone: str('phone'), locker: str('locker'), notes: str('notes'), gift: d.has('gift'), terms: d.has('terms') };
  }

  function showError(field: Field, invalid: boolean, message?: string) {
    const err = q(`#co-${field}-err`);
    q(`#co-${field}`).setAttribute('aria-invalid', String(invalid));
    err.textContent = invalid ? (message ?? err.dataset.msg ?? '') : '';
  }

  const check = (field: Field) => showError(field, validate(readForm()).includes(field));

  FIELDS.forEach((field) => {
    const input = q<HTMLInputElement>(`#co-${field}`);
    input.addEventListener('blur', () => (input.type === 'checkbox' || input.value) && check(field));
    input.addEventListener('input', () => input.getAttribute('aria-invalid') === 'true' && check(field));
    input.addEventListener('change', () => input.type === 'checkbox' && check(field));
  });
  q<HTMLInputElement>('#co-locker').addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    el.value = normalizeLocker(el.value);
  });

  interface ApiError { error?: string; fields?: string[]; reasons?: Record<string, string> }

  /** Błędy pól zwrócone przez serwer (te same reguły + np. nieistniejący paczkomat). true = pokazano przy polach. */
  function showServerFields(json: ApiError): boolean {
    const fields = (json.fields ?? []).filter((f): f is Field => (FIELDS as string[]).includes(f));
    if (!fields.length) return false;
    fields.forEach((f) => showError(f, true, json.reasons?.[f] === 'not_found' ? t.lockerNotFound : undefined));
    q(`#co-${fields[0]}`).focus();
    return true;
  }

  async function submitToApi(endpoint: string, data: OrderForm, items: ReturnType<typeof read>) {
    // API przelicza ceny po stronie serwera, rezerwuje stan atomowo i zwraca link do płatności (worker/services/PlaceOrderService.ts).
    const btn = q<HTMLButtonElement>('[data-co-submit]');
    const setLoading = (loading: boolean) => {
      btn.dataset.state = loading ? 'loading' : '';
      btn.disabled = loading;
      btn.textContent = loading ? t.submitting : t.submitPay;
    };
    // Kod błędu = początek correlationId żądania: po nim znajdę dokładnie to zamówienie w logach.
    // Token Turnstile jest jednorazowy - po każdej nieudanej próbie potrzebny nowy.
    const resetCaptcha = () => (window as unknown as { turnstile?: { reset(): void } }).turnstile?.reset();
    const fail = (message: string, ref: string) => {
      setLoading(false);
      resetCaptcha();
      alert(ref ? `${message}\n\n${fill(t.errorRef, { ref: ref.slice(0, 8) })}` : message);
    };

    if (!withinOrderLimits(items)) return alert(t.tooManyItems);
    setLoading(true);
    let previous: string | null = null;
    try { previous = localStorage.getItem(PENDING_ORDER_KEY); } catch { /* tryb prywatny */ }

    let res: Response;
    try {
      res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...data,
          phone: normalizePhone(data.phone),
          locker: normalizeLocker(data.locker),
          items: items.map(({ id, qty }) => ({ id, qty })),
          ...(previous && { previous }),
          captcha: new FormData(form).get('cf-turnstile-response') ?? undefined,
        }),
      });
    } catch {
      return fail(t.submitError, ''); // offline / sieć
    }
    const ref = res.headers.get('correlation-id') ?? '';
    const json = (await res.json().catch(() => ({}))) as ApiError & { orderId?: string; redirect?: string };

    if (res.ok && json.redirect) {
      try { localStorage.setItem(PENDING_ORDER_KEY, json.orderId ?? ''); } catch { /* rezerwacja wygaśnie sama */ }
      location.href = json.redirect;
      return;
    }
    if (res.status === 409 && json.error === 'stock') {
      // Ktoś kupił ostatnie sztuki - uzgodnij koszyk i pokaż, co się zmieniło.
      await sync(true);
      render();
      return fail(t.stockError, '');
    }
    if (res.status === 400 && showServerFields(json)) {
      resetCaptcha();
      return setLoading(false);
    }
    if (json.error === 'captcha') return fail(t.captchaError, '');
    if (json.error === 'pending_limit') return fail(t.pendingLimit, '');
    if (res.status === 429) return fail(t.rateLimited, '');
    fail(t.submitError, ref);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = readForm();
    const invalid = validate(data);
    FIELDS.forEach((f) => showError(f, invalid.includes(f)));
    if (invalid.length) {
      q(`#co-${invalid[0]}`).focus();
      return;
    }
    await sync(true); // ostatnie uzgodnienie cen i stanów przed złożeniem zamówienia
    const { items, sum } = render();
    if (items.length === 0) return;

    if (form.dataset.endpoint) return submitToApi(form.dataset.endpoint, data, items);

    q('[data-co-text]').textContent = summaryText(items, sum, data, t);
    q('[data-co-main]').hidden = true;
    const fb = q('[data-co-fallback]');
    fb.hidden = false;
    fb.focus();
  });

  q('[data-co-copy]').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(q('[data-co-text]').textContent ?? '');
      q('[data-co-copied]').textContent = t.copied;
    } catch {
      q('[data-co-copied]').textContent = t.copyFailed;
    }
  });

  // InPost Geowidget - ładowany dopiero po kliknięciu
  const geo = document.querySelector<HTMLDialogElement>('[data-geo]');
  if (geo) {
    let loaded = false;
    q('[data-geo-open]').addEventListener('click', () => {
      if (!loaded) {
        loaded = true;
        const map = q('[data-geo-map]');
        const el = document.createElement('inpost-geowidget');
        Object.entries({ token: map.dataset.token ?? '', language: 'pl', config: 'parcelcollect', onpoint: 'byn-point' }).forEach(([k, v]) => el.setAttribute(k, v));
        map.append(el);
        document.head.append(
          Object.assign(document.createElement('link'), { rel: 'stylesheet', href: 'https://geowidget.inpost.pl/inpost-geowidget.css' }),
          Object.assign(document.createElement('script'), { src: 'https://geowidget.inpost.pl/inpost-geowidget.js', defer: true }),
        );
        document.addEventListener('byn-point', (ev) => {
          const name = (ev as CustomEvent<{ name?: string }>).detail?.name ?? '';
          const input = q<HTMLInputElement>('#co-locker');
          input.value = name;
          q('[data-locker-hint]').textContent = fill(t.lockerSelected, { name });
          check('locker');
          geo.close();
          input.focus();
        });
      }
      geo.showModal();
    });
    q('[data-geo-close]').addEventListener('click', () => geo.close());
  }

  document.addEventListener(CHANGE_EVENT, render);
  render();
  void sync(true);
</script>

<style>
  .layout { margin-top: var(--sp-6); }
  .empty { padding: var(--sp-7) 0; }
  :global(html.co-empty) [data-co-main] { display: none; }
  :global(html.co-empty) [data-co-empty] { display: block !important; }
  @media (min-width: 56rem) { .side { position: sticky; top: var(--sp-5); } }

  fieldset { border: 0; padding: 0; margin: 0 0 var(--sp-7); display: grid; gap: var(--sp-4); }
  @media (min-width: 40rem) { .contact { grid-template-columns: 1fr 1fr; } .contact [data-field='name'] { grid-column: 1 / -1; } }
  legend { font-family: var(--f-serif); font-size: var(--fs-xl); margin-bottom: var(--sp-4); display: flex; align-items: center; gap: var(--sp-3); }
  .step { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: var(--r-pill); background: var(--c-text); color: var(--c-surface); font: 400 var(--fs-sm) var(--f-sans); }
  .field { display: grid; gap: var(--sp-1); align-content: start; }
  label { font-size: var(--fs-sm); }
  input:not([type='checkbox']), textarea {
    font: inherit; min-height: var(--tap); padding: var(--sp-2) var(--sp-4); border: 1px solid var(--c-border-strong); border-radius: var(--r-sm);
    background: var(--c-surface); color: var(--c-text); transition: border-color var(--t-fast) var(--ease);
  }
  input:hover, textarea:hover { border-color: var(--c-text); }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 1px; border-color: var(--c-accent); }
  input[aria-invalid='true'] { border-color: var(--c-error); }
  .hint, .err { font-size: var(--fs-sm); margin: 0; }
  .hint { color: var(--c-text-muted); }
  .err { color: var(--c-error); }
  .err:empty { display: none; }
  .check { display: flex; gap: var(--sp-3); align-items: flex-start; min-height: var(--tap); cursor: pointer; }
  .check input { width: 20px; height: 20px; margin-top: 3px; accent-color: var(--c-accent); flex: none; }
  .captcha { margin-bottom: var(--sp-4); }
  .center { text-align: center; max-width: none; margin-top: var(--sp-3); }

  .side { background: var(--c-surface); border-radius: var(--r-md); padding: var(--sp-6); }
  .h3 { font-size: var(--fs-xl); }
  .lines { list-style: none; margin: 0 0 var(--sp-4); padding: 0 0 var(--sp-4); display: grid; gap: var(--sp-2); font-size: var(--fs-sm); border-bottom: 1px solid var(--c-border); }
  .lines :global(li) { display: flex; justify-content: space-between; gap: var(--sp-4); }
  .side .link-btn { margin-top: var(--sp-3); }

  .fallback { max-width: 44rem; margin-top: var(--sp-6); outline: none; }
  .summary-text { white-space: pre-wrap; font: var(--fs-sm) / 1.6 var(--f-sans); background: var(--c-surface); border-radius: var(--r-md); padding: var(--sp-5); margin: var(--sp-5) 0; }
  .fallback .actions { margin-bottom: var(--sp-3); }

  .geo { width: min(60rem, 96vw); height: min(40rem, 90dvh); padding: 0; border: 0; border-radius: var(--r-md); }
  .geo::backdrop { background: var(--c-overlay); }
  .geo-map { width: 100%; height: 100%; }
  .geo-close { position: absolute; top: var(--sp-2); right: var(--sp-2); z-index: 2; background: var(--c-surface); font-size: var(--fs-xl); }
</style>
