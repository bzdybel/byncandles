---
import Base from '../layouts/Base.astro';
import { delivery as d } from '../i18n/pl';
import { fill } from '../lib/i18n';
import { formatZl } from '../lib/money';
import { ustawienia } from '../lib/shop';

const u = await ustawienia();
const rows = [
  [d.locker, u.wysylkaPaczkomat ? formatZl(u.wysylkaPaczkomat) : d.costInCart],
  ...(u.wysylkaKurier !== undefined ? [[d.courier, formatZl(u.wysylkaKurier)]] : []),
  ...(u.darmowaWysylkaOd !== undefined ? [[d.freeShipping, fill(d.freeFrom, { price: formatZl(u.darmowaWysylkaOd) })]] : []),
];
---
<Base title={d.metaTitle} description={d.metaDescription}>
  <article class="container section--tight prose">
    <h1>{d.title}</h1>
    <p class="t-lead">{d.lead}</p>

    <h2>{d.shippingTitle}</h2>
    <dl class="table">{rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    <p>{d.tracking}</p>
    <!-- TODO: czas realizacji zamówienia - do potwierdzenia przez Natalię -->

    <h2>{d.packingTitle}</h2>
    <p>{d.packingText}</p>

    <h2>{d.returnTitle}</h2>
    {d.returnText.map((t) => <p>{t}</p>)}
    <p class="t-small t-muted">{d.returnException}</p>
    <!-- TODO: adres do zwrotów i dane sprzedawcy - po uzupełnieniu formy działalności -->

    <h2>{d.complaintTitle}</h2>
    <p>{d.complaintBefore}<a href="/regulamin/">{d.complaintLink}</a>.</p>
    <p><a class="link-arrow" href="/kontakt/"><span>{d.question}</span></a></p>
  </article>
</Base>

<style>
  .prose { max-width: 46rem; }
  .prose h2 { font-size: var(--fs-xl); margin-top: var(--sp-7); }
  .table { margin: 0 0 var(--sp-5); border-top: 1px solid var(--c-border); }
  .table div { display: flex; justify-content: space-between; gap: var(--sp-4); padding-block: var(--sp-3); border-bottom: 1px solid var(--c-border); }
  dt { color: var(--c-text-muted); }
  dd { margin: 0; font-variant-numeric: tabular-nums; }
</style>
