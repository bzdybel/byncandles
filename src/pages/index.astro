---
import Img from '../components/Img.astro';
import Base from '../layouts/Base.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { brand, common, home } from '../i18n/pl';
import { IMG } from '../lib/images';
import { produktyPubliczne } from '../lib/shop';
import { SITE, SITE_URL } from '../lib/site';

const wszystkie = await produktyPubliczne();
const wyroznione = wszystkie.filter((p) => p.data.wyrozniony);
const polecane = (wyroznione.length ? wyroznione : wszystkie).slice(0, 4);

const [glowne, ...male] = (['krowki', 'muszle', 'misie', 'buldog', 'wSzkle'] as const).map((key) => ({ img: IMG[key], label: home.gallery[key] }));
const proces = [IMG.procesKnot, IMG.procesZapach, IMG.procesOdlewanie];
const materialy = home.materials;

const jsonLd = [
  { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: brand.name, url: SITE_URL, sameAs: [SITE.instagram], founder: { '@id': `${SITE_URL}/o-mnie/#natalia` } },
  { '@type': 'WebSite', '@id': `${SITE_URL}/#website`, name: brand.name, url: SITE_URL, inLanguage: 'pl-PL', publisher: { '@id': `${SITE_URL}/#organization` } },
];
---
<Base title={home.metaTitle} description={home.metaDescription} jsonLd={jsonLd}>
  <section class="container split hero" style="--split: 1.05fr 1fr">
    <div>
      <span class="overline">{home.heroOverline}</span>
      <h1 class="t-display">{home.heroTitle} <em>{home.heroTitleEm}</em></h1>
      <p class="t-lead">{home.heroLead}</p>
      <div class="actions">
        <a class="btn btn--lg" href="/sklep/">{common.seeCollection}</a>
        <a class="btn btn--ghost btn--lg" href="/o-mnie/">{home.heroSecondary}</a>
      </div>
    </div>
    <div class="frame frame--arch frame--portrait">
      <Img {...IMG.roze} widths={[420, 640, 860, 1100]} sizes="(min-width: 56rem) 42vw, 92vw" eager />
    </div>
  </section>

  {polecane.length > 0 && (
    <section class="container section--tight" aria-labelledby="featured">
      <div class="section-head">
        <h2 id="featured">{home.featured}</h2>
        <a class="link-arrow" href="/sklep/"><span>{home.featuredMore}</span></a>
      </div>
      <ProductGrid produkty={polecane} />
    </section>
  )}

  <section class="band band--surface" aria-labelledby="process">
    <div class="container section">
      <div class="process-head">
        <h2 id="process">{home.processTitle} <em>{home.processTitleEm}</em></h2>
        <p class="t-muted">{home.processLead}</p>
      </div>
      <ol class="steps" role="list">
        {home.processSteps.map((k, i) => (
          <li>
            <div class="frame step-img">
              <Img {...proces[i]} widths={[320, 480, 640]} sizes="(min-width: 56rem) 28vw, (min-width: 36rem) 45vw, 88vw" />
            </div>
            <span class="num" aria-hidden="true">0{i + 1}</span>
            <h3>{k.title}</h3>
            <p class="t-muted">{k.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container section" aria-labelledby="studio">
    <div class="section-head">
      <h2 id="studio">{home.galleryTitle} <em>{home.galleryTitleEm}</em></h2>
      <a class="link-arrow" href={SITE.instagram} rel="noopener" target="_blank"><span>{home.galleryMore}</span></a>
    </div>
    <div class="gallery">
      <figure class="g-main">
        <div class="frame"><Img {...glowne.img} widths={[480, 720, 960]} sizes="(min-width: 56rem) 48vw, 92vw" /></div>
        <figcaption>{glowne.label}</figcaption>
      </figure>
      {male.map(({ img, label }) => (
        <figure>
          <div class="frame"><Img {...img} widths={[320, 480]} sizes="(min-width: 56rem) 23vw, 46vw" /></div>
          <figcaption>{label}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="band band--alt" aria-labelledby="materials">
    <div class="container section split" style="--split: 1fr 1.1fr">
      <div class="frame frame--portrait">
        <Img {...IMG.pszczeli} widths={[400, 640, 900]} sizes="(min-width: 56rem) 40vw, 92vw" />
      </div>
      <div>
        <h2 id="materials">{home.materialsTitle}</h2>
        {materialy.map((m) => (
          <div class="mat">
            <h3>{m.title}</h3>
            <p class="t-muted">{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--blush" aria-labelledby="gift">
    <div class="container section split">
      <div>
        <h2 id="gift">{home.giftTitle} <em>{home.giftTitleEm}</em></h2>
        {home.giftText.map((t) => <p>{t}</p>)}
        <div class="actions gift-actions">
          <a class="btn" href="/kontakt/">{home.giftCta}</a>
          <a class="btn btn--ghost" href="/sklep/">{home.giftSecondary}</a>
        </div>
      </div>
      <div class="gift-imgs">
        <div class="frame frame--portrait"><Img {...IMG.prezentPudelka} widths={[320, 480, 640]} sizes="(min-width: 56rem) 26vw, 55vw" /></div>
        <div class="frame frame--portrait offset"><Img {...IMG.prezentAlpaka} widths={[280, 420, 560]} sizes="(min-width: 56rem) 20vw, 42vw" /></div>
      </div>
    </div>
  </section>

  <section class="container section split" style="--split: 0.9fr 1fr" aria-labelledby="about-teaser">
    <div class="frame frame--arch frame--portrait">
      <Img {...IMG.kurka} widths={[400, 640, 900]} sizes="(min-width: 56rem) 38vw, 92vw" />
    </div>
    <div>
      <span class="overline">{home.aboutOverline}</span>
      <h2 id="about-teaser">{home.aboutTitle} <em>{home.aboutTitleEm}</em></h2>
      <blockquote><p>{home.aboutQuote}</p></blockquote>
      <a class="link-arrow" href="/o-mnie/"><span>{common.readMore}</span></a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: var(--sp-5) var(--sp-8); }
  @media (min-width: 56rem) { .hero { padding-block: var(--sp-6) var(--sp-9); } }
  .hero .t-lead { margin-bottom: var(--sp-6); }

  .band--surface { background: var(--c-surface); }
  .band--alt { background: var(--c-surface-alt); }
  .band--blush { background: var(--c-blush); }

  .process-head { display: grid; gap: var(--sp-2); margin-bottom: var(--sp-7); }
  .process-head h2 { margin: 0; }
  @media (min-width: 56rem) { .process-head { grid-template-columns: 1fr 1fr; align-items: end; } .process-head p { justify-self: end; text-align: right; margin: 0; } }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-7) var(--sp-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .step-img { aspect-ratio: 3 / 4; margin-bottom: var(--sp-4); }
  .num { display: block; font-family: var(--f-serif); font-style: italic; font-size: var(--fs-xl); color: var(--c-accent); margin-bottom: var(--sp-1); }
  .steps h3 { margin-bottom: var(--sp-2); }

  .gallery { display: grid; gap: var(--sp-3); grid-template-columns: repeat(2, 1fr); }
  figure { margin: 0; position: relative; }
  .gallery .frame { aspect-ratio: 4 / 5; }
  .g-main { grid-column: 1 / -1; }
  .g-main .frame { aspect-ratio: 4 / 3; }
  @media (min-width: 56rem) {
    .gallery { grid-template-columns: 2fr 1fr 1fr; gap: var(--sp-4); }
    .g-main { grid-column: 1; grid-row: 1 / span 2; }
    .g-main .frame { aspect-ratio: auto; height: 100%; }
  }
  figcaption {
    position: absolute; left: var(--sp-3); bottom: var(--sp-3); background: color-mix(in srgb, var(--c-surface) 92%, transparent);
    padding: 0.35em 0.9em; border-radius: var(--r-pill); font-size: var(--fs-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-text);
  }

  .mat { padding-top: var(--sp-5); margin-top: var(--sp-5); border-top: 1px solid color-mix(in srgb, var(--c-text) 15%, transparent); }
  .mat h3 { margin-bottom: var(--sp-2); }

  .gift-actions { margin-top: var(--sp-5); }
  .gift-imgs { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--sp-4); align-items: start; }
  .offset { margin-top: var(--sp-8); }

  blockquote { margin: 0 0 var(--sp-4); padding-left: var(--sp-5); border-left: 2px solid var(--c-accent); }
  blockquote p { font-family: var(--f-serif); font-style: italic; font-size: var(--fs-xl); line-height: 1.5; }
</style>
