---
import { getImage } from 'astro:assets';
import Img from '../components/Img.astro';
import Base from '../layouts/Base.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { brand, common, home } from '../i18n/pl';
import { IMG } from '../lib/images';
import { SHARE } from '../lib/media';
import { produktyPubliczne } from '../lib/shop';
import { SITE, SITE_URL } from '../lib/site';

const wszystkie = await produktyPubliczne();
const wyroznione = wszystkie.filter((p) => p.data.wyrozniony);
const polecane = (wyroznione.length ? wyroznione : wszystkie).slice(0, 4);

// Górny rząd mozaiki (3 zdjęcia) jest widoczny bez przewijania na ekranach od ~1080 px wysokości — bez lazy-load.
// Zdjęcia na stronie nie powinny się powtarzać (także ze stopką). 4 najlepsze prace — same zdjęcia, bez podpisów (asortyment i opisy są w sklepie).
const prace = (['wSzkle', 'krowki', 'muszle', 'buldog'] as const).map((key) => IMG[key]);
const proces = [IMG.procesKnot, IMG.procesZapach, IMG.procesOdlewanie];
// Sekcja „Jak powstają świece” chwilowo ukryta — zmień na true, żeby ją przywrócić.
const pokazProces = false;

// Obrazek do udostępniania (Facebook, Messenger, WhatsApp) — zdjęcie z hero
const ogImage = new URL((await getImage({ src: IMG.roze.src, ...SHARE })).src, SITE_URL).href;

const jsonLd = [
  { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: brand.name, url: SITE_URL, image: ogImage, sameAs: [SITE.instagram], founder: { '@type': 'Person', name: brand.author } },
  { '@type': 'WebSite', '@id': `${SITE_URL}/#website`, name: brand.name, url: SITE_URL, inLanguage: 'pl-PL', publisher: { '@id': `${SITE_URL}/#organization` } },
];
---
<Base title={home.metaTitle} description={home.metaDescription} image={ogImage} jsonLd={jsonLd}>
  <!-- Hero: pas latte, tekst + zdjęcie w łuku -->
  <section class="band--latte">
    <div class="container split hero" style="--split: 1.1fr 1fr">
      <div class="hero-text">
        <h1 class="t-display">{home.heroTitle}</h1>
        <figure class="hero-quote">
          <blockquote><p>{home.heroQuote}</p></blockquote>
          <figcaption>{home.heroSignature}</figcaption>
        </figure>
        <div class="actions">
          <a class="btn btn--lg" href="/sklep/">{common.seeCollection}</a>
          <a class="btn btn--ghost btn--lg" href="/kontakt/">{common.customOrder}</a>
        </div>
      </div>
      <div class="hero-img">
        <div class="frame frame--arch frame--portrait" data-parallax>
          <Img {...IMG.roze} widths={[420, 640, 860, 1100]} sizes="(min-width: 56rem) 40vw, 92vw" eager />
        </div>
      </div>
    </div>
  </section>

  <!-- 1. Wiodąca sekcja: wybrane świece ze sklepu, a dopóki ich brak — mozaika prac (1 duże zdjęcie + 3 mniejsze + kafel z tytułem) -->
  {polecane.length > 0 ? (
    <section class="container section" aria-labelledby="featured">
      <div class="section-head" data-reveal>
        <h2 id="featured" data-reveal-item>{home.featured}</h2>
        <a class="link-arrow" href="/sklep/"><span>{home.featuredMore}</span></a>
      </div>
      <ProductGrid produkty={polecane} />
    </section>
  ) : (
    <section class="container section" aria-labelledby="studio">
      <ul class="gallery" role="list" data-reveal>
        {prace.map((img, i) => (
          <li class:list={['frame', { 'is-lead': i === 0 }]} style={`--i: ${i}`} data-reveal-item>
            <Img {...img} widths={i === 0 ? [640, 960, 1280] : [360, 560, 760]} sizes={i === 0 ? '(min-width: 56rem) 48vw, 92vw' : '(min-width: 56rem) 23vw, 46vw'} noLazy={i < 3} />
          </li>
        ))}
        <li class="gallery-title" style="--i: 4" data-reveal-item>
          <h2 id="studio">{home.galleryOverline}</h2>
          <a class="link-arrow" href={SITE.instagram} rel="noopener" target="_blank"><span>{home.galleryMore}</span></a>
        </li>
      </ul>
    </section>
  )}

  <!-- 2. Proces (chwilowo ukryty) -->
  {pokazProces && <section class="container section center-head" aria-labelledby="process">
    <h2 id="process">{home.processTitle} <em>{home.processTitleEm}</em></h2>
    <ol class="steps" role="list" data-reveal>
      {home.processSteps.map((k, i) => (
        <li style={`--i: ${i}`} data-reveal-item>
          <div class="frame step-img">
            <Img {...proces[i]} widths={[320, 480, 640]} sizes="(min-width: 56rem) 28vw, (min-width: 36rem) 45vw, 88vw" />
          </div>
          <span class="num" aria-hidden="true">0{i + 1}</span>
          <h3>{k.title}</h3>
          <p class="t-muted">{k.text}</p>
        </li>
      ))}
    </ol>
  </section>}

  <!-- 3. Materiały -->
  <section class="band--sand" aria-labelledby="materials">
    <div class="container section split" style="--split: 1fr 1.1fr" data-reveal>
      <div class="frame frame--portrait matted" data-reveal-item data-parallax>
        <Img {...IMG.cytryna} widths={[400, 640, 900]} sizes="(min-width: 56rem) 40vw, 92vw" />
      </div>
      <div>
        <h2 id="materials" style="--i: 1" data-reveal-item>{home.materialsTitle} <em>{home.materialsTitleEm}</em></h2>
        {home.materials.map((m, i) => (
          <div class="mat" style={`--i: ${i + 2}`} data-reveal-item>
            <h3>{m.title}</h3>
            <p class="t-muted">{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Na prezent i na zamówienie -->
  <section id="gift" class="container section split" aria-labelledby="gift-title" data-reveal>
    <div data-reveal-item>
      <h2 id="gift-title">{home.giftTitle} <em>{home.giftTitleEm}</em></h2>
      {home.giftText.map((t) => <p>{t}</p>)}
      <div class="actions gift-actions">
        <a class="btn" href="/kontakt/">{home.giftCta}</a>
        <a class="btn btn--ghost" href="/sklep/">{home.giftSecondary}</a>
      </div>
    </div>
    <div class="frame gift-img" style="--i: 1" data-reveal-item data-parallax>
      <Img {...IMG.prezentPudelka} widths={[480, 640, 810]} sizes="(min-width: 56rem) 52vw, 92vw" />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding-block: var(--sp-7) var(--sp-8); }
  @media (min-width: 56rem) { .hero { padding-block: var(--sp-8) var(--sp-9); } }
  .hero h1 { margin-bottom: var(--sp-5); }
  .hero-quote { margin: 0 0 var(--sp-6); }
  .hero-quote blockquote { margin: 0; }
  .hero-quote p { font-family: var(--f-serif); font-style: italic; font-size: var(--fs-xl); line-height: 1.5; color: var(--c-text-muted); max-width: 46ch; margin: 0; }
  .hero-quote figcaption { width: fit-content; margin-top: var(--sp-2); font-family: var(--f-script); font-size: 2.25rem; line-height: 1; color: var(--c-accent); }
  .hero-img { position: relative; max-width: 30rem; width: 100%; justify-self: center; }
  .hero-img .frame { box-shadow: 0 0 0 10px var(--c-bg); }

  /* Intro przy pierwszej wizycie: tytuł, cytat, podpis „pisany” ręką, przyciski; zdjęcie wypływa jak w karuzeli */
  :global(.js-intro) .hero h1 { animation: rise 1000ms var(--ease-out) 150ms both; }
  :global(.js-intro) .hero-quote p { animation: rise 1000ms var(--ease-out) 350ms both; }
  :global(.js-intro) .hero-quote figcaption { animation: write 1500ms var(--ease) 950ms both; }
  :global(.js-intro) .hero .actions { animation: rise 1000ms var(--ease-out) 600ms both; }
  :global(.js-intro) .hero-img { animation: rise 1100ms var(--ease-out) 300ms both; }

  /* Nagłówki wyśrodkowane */
  .center-head { text-align: center; }
  .center-head > h2 { margin-inline: auto; max-width: 26ch; margin-bottom: var(--sp-7); }

  /* Galeria prac */
  .gallery { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); grid-template-columns: repeat(2, 1fr); }
  .gallery .frame { aspect-ratio: 3 / 4; }
  .gallery .is-lead { grid-column: 1 / -1; }
  .gallery-title {
    display: grid; place-content: center; justify-items: center; gap: var(--sp-3); text-align: center;
    padding: var(--sp-5); background: var(--c-latte); border-radius: var(--r-md);
  }
  .gallery-title h2 { margin: 0; }
  @media (min-width: 56rem) {
    .gallery { grid-template-columns: 2fr 1fr 1fr; gap: var(--sp-4); }
    .gallery .is-lead { grid-column: 1; grid-row: 1 / span 2; aspect-ratio: auto; }
  }
  @media (hover: hover) { .gallery.is-in li:hover :global(img) { transform: scale(1.05); transition-duration: var(--t-slower); transition-delay: 0ms; } }

  /* Proces */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-7) var(--sp-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .steps p { margin-inline: auto; max-width: 34ch; }
  .step-img { aspect-ratio: 3 / 4; margin-bottom: var(--sp-4); }
  .num { display: block; font-family: var(--f-script); font-size: 2rem; line-height: 1; color: var(--c-accent); margin-bottom: var(--sp-1); }
  .steps h3 { margin-bottom: var(--sp-2); text-transform: uppercase; letter-spacing: var(--tracking-heading); font-size: var(--fs-lg); }

  /* Zdjęcie w białym passe-partout (jak kadry w inspiracjach) */
  .matted { box-shadow: 0 0 0 10px var(--c-surface), 0 18px 40px -24px rgb(47 38 32 / 0.35); }

  .mat { padding-top: var(--sp-5); margin-top: var(--sp-5); border-top: 1px solid color-mix(in srgb, var(--c-text) 18%, transparent); }
  .mat h3 { margin-bottom: var(--sp-2); text-transform: uppercase; letter-spacing: var(--tracking-heading); font-size: var(--fs-lg); }

  .gift-actions { margin-top: var(--sp-5); }
  /* Jedno zdjęcie pudełek prezentowych w poziomie (4:3, kadr ze środka pionowego oryginału); kolumna zdjęcia szersza od tekstu */
  .gift-img { aspect-ratio: 4 / 3; width: 100%; }
  @media (min-width: 56rem) { #gift { --split: 1fr 1.25fr; } }
</style>
