---
import Img from '../components/Img.astro';
import Base from '../layouts/Base.astro';
import { about, brand, common } from '../i18n/pl';
import { IMG } from '../lib/images';
import { SITE, SITE_URL } from '../lib/site';

const jsonLd = {
  '@type': 'AboutPage',
  url: `${SITE_URL}/o-mnie/`,
  mainEntity: {
    '@type': 'Person',
    '@id': `${SITE_URL}/o-mnie/#natalia`,
    name: brand.author,
    jobTitle: about.jobTitle,
    worksFor: { '@id': `${SITE_URL}/#organization` },
    sameAs: [SITE.instagram],
  },
};
---
<Base title={about.metaTitle} description={about.metaDescription} jsonLd={jsonLd}>
  <article class="container section--tight split split--top" style="--split: 0.9fr 1fr">
    <div class="frame frame--arch frame--portrait sticky">
      <!-- TODO: portret Natalii lub zdjęcie z pracowni -->
      <Img {...IMG.rozaWrzosowa} widths={[420, 640, 900]} sizes="(min-width: 56rem) 40vw, 92vw" eager />
    </div>
    <div>
      <h1>{about.title} <em>{about.titleEm}</em></h1>
      <p class="t-lead">{about.lead}</p>
      {about.body.map((t) => <p>{t}</p>)}
      <!-- TODO: historia marki od Natalii — jak to się zaczęło, skąd nazwa, co ją inspiruje -->
      <figure class="studio">
        <div class="frame"><Img {...IMG.procesOdlewanie} widths={[320, 480]} sizes="9rem" /></div>
        <figcaption class="t-small t-muted">{about.studioCaption}</figcaption>
      </figure>
      <div class="actions">
        <a class="btn btn--lg" href="/sklep/">{common.seeCandles}</a>
        <a class="btn btn--ghost btn--lg" href={SITE.instagram} rel="me noopener" target="_blank">{about.instagram}</a>
      </div>
    </div>
  </article>
</Base>

<style>
  @media (min-width: 56rem) { .sticky { position: sticky; top: var(--sp-5); } }
  .t-lead { margin-bottom: var(--sp-5); }
  .studio { display: grid; grid-template-columns: 9rem 1fr; gap: var(--sp-4); align-items: end; margin: var(--sp-6) 0 var(--sp-7); }
  .studio .frame { aspect-ratio: 3 / 4; }
</style>
