---
import Img from '../components/Img.astro';
import Base from '../layouts/Base.astro';
import { common, contact } from '../i18n/pl';
import { IMG } from '../lib/images';
import { ustawienia } from '../lib/shop';
import { SITE, SITE_URL } from '../lib/site';

const { email } = await ustawienia();
const jsonLd = { '@type': 'ContactPage', url: `${SITE_URL}/kontakt/`, about: { '@id': `${SITE_URL}/#organization` } };
---
<Base title={contact.metaTitle} description={contact.metaDescription} jsonLd={jsonLd}>
  <section class="container section--tight split split--top" style="--split: 1.1fr 0.9fr">
    <div>
      <h1>{contact.title} <em>{contact.titleEm}</em></h1>
      <p class="t-lead">{contact.lead}</p>
      <ul class="channels" role="list">
        <li>
          <span class="overline">{contact.fastest}</span>
          <a class="channel" href={SITE.instagram} rel="noopener" target="_blank">{contact.instagramMessage}<span aria-hidden="true"> →</span></a>
          <span class="t-small t-muted">{common.instagramHandle}</span>
        </li>
        {email && (
          <li>
            <span class="overline">{contact.email}</span>
            <a class="channel" href={`mailto:${email}`}>{email}</a>
          </li>
        )}
      </ul>
      <h2 class="h3">{contact.customTitle}</h2>
      <p>{contact.customText}</p>
    </div>
    <div class="frame frame--portrait">
      <Img {...IMG.prezentPudelka} widths={[400, 640, 810]} sizes="(min-width: 56rem) 36vw, 92vw" eager />
    </div>
  </section>
</Base>

<style>
  .channels { list-style: none; padding: 0; margin: var(--sp-6) 0 var(--sp-7); display: grid; gap: var(--sp-5); }
  .channels li { display: grid; }
  .channels .overline { margin-bottom: 0; }
  .channel { display: inline-flex; align-items: center; min-height: var(--tap); font-family: var(--f-serif); font-size: var(--fs-xl); text-decoration: none; }
  .channel:hover { text-decoration: underline; }
  .h3 { font-size: var(--fs-xl); }
</style>
