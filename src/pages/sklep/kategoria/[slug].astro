---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import ProductGrid from '../../../components/ProductGrid.astro';
import { nav, shop } from '../../../i18n/pl';
import { fill } from '../../../lib/i18n';
import { kategorieZProduktami, produktyPubliczne, urlKategorii } from '../../../lib/shop';

export const getStaticPaths = (async () => {
  const produkty = await produktyPubliczne();
  const kategorie = await kategorieZProduktami(produkty);
  return kategorie.map((k) => ({
    params: { slug: k.id },
    props: { k, kategorie, produkty: produkty.filter((p) => p.data.kategoria?.id === k.id) },
  }));
}) satisfies GetStaticPaths;

const { k, kategorie, produkty } = Astro.props;
const description = k.data.opis?.split('\n')[0].slice(0, 160) ?? fill(shop.categoryFallbackDescription, { name: k.data.nazwa });
---
<Base title={k.data.nazwa} description={description}>
  <section class="container section--tight">
    <Breadcrumbs items={[{ label: nav.shop, href: '/sklep/' }, { label: k.data.nazwa, href: urlKategorii(k) }]} />
    <h1>{k.data.nazwa}</h1>
    {k.data.opis?.split(/\n{2,}/).map((para) => <p class="t-lead">{para}</p>)}
    <div class="spacer"></div>
    <CategoryNav kategorie={kategorie} />
    <ProductGrid produkty={produkty} eagerFirst={2} headingLevel={2} />
  </section>
</Base>

<style>
  .spacer { height: var(--sp-5); }
</style>
