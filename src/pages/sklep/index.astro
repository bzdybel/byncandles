---
import Base from '../../layouts/Base.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import EmptyShop from '../../components/EmptyShop.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { shop } from '../../i18n/pl';
import { kategorieZProduktami, produktyPubliczne } from '../../lib/shop';

const produkty = await produktyPubliczne();
const kategorie = await kategorieZProduktami(produkty);
---
<Base title={shop.metaTitle} description={shop.metaDescription}>
  <section class="container section--tight">
    <header class="head">
      <h1>{shop.title}</h1>
      <p class="t-lead">{shop.lead}</p>
    </header>
    <CategoryNav kategorie={kategorie} />
    {produkty.length > 0 ? <ProductGrid produkty={produkty} eagerFirst={2} headingLevel={2} /> : <EmptyShop />}
  </section>
</Base>

<style>
  .head { margin-bottom: var(--sp-7); }
</style>
