---
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Accordion from '../../components/Accordion.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Price from '../../components/Price.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import { nav, product as t, status, wax } from '../../i18n/pl';
import { fill } from '../../lib/i18n';
import { SHARE, THUMB } from '../../lib/media';
import { formatZl, toGrosze } from '../../lib/money';
import { productJsonLd } from '../../lib/schema';
import { cenaAktualna, naStanie, produktyPubliczne, urlKategorii, urlProduktu, ustawienia } from '../../lib/shop';
import { SITE_URL } from '../../lib/site';

export const getStaticPaths = (async () =>
  (await produktyPubliczne()).map((produkt) => ({ params: { slug: produkt.id }, props: { produkt } }))) satisfies GetStaticPaths;

const { produkt } = Astro.props;
const p = produkt.data;
const kategoria = p.kategoria ? await getEntry(p.kategoria) : undefined;
const u = await ustawienia();
const kupno = naStanie(p);
const paras = (text?: string) => text?.split(/\n{2,}/) ?? [];

const wysylka = [
  `${t.shippingLocker}${u.wysylkaPaczkomat ? ` ${formatZl(u.wysylkaPaczkomat)}` : ''}`,
  u.darmowaWysylkaOd !== undefined && fill(t.shippingFreeFrom, { price: formatZl(u.darmowaWysylkaOd) }),
  t.returnDays,
].filter(Boolean).join(' · ');

const s = p.szczegoly;
const z = p.zapach;
const specs = [
  [t.specs.wosk, s?.wosk && wax[s.wosk]],
  [t.specs.knot, s?.knot],
  [t.specs.gramatura, s?.gramatura && fill(t.grams, { n: s.gramatura })],
  [t.specs.czasPalenia, s?.czasPalenia && fill(t.burnHours, { n: s.czasPalenia })],
  [t.specs.pojemnik, s?.pojemnik],
  [t.specs.nutyGlowy, z?.nutyGlowy],
  [t.specs.nutySerca, z?.nutySerca],
  [t.specs.nutyBazy, z?.nutyBazy],
].filter((r): r is [string, string] => Boolean(r[1]));

const [miniatura, ...share] = await Promise.all([
  getImage({ src: p.zdjecia[0].zdjecie, ...THUMB }),
  ...p.zdjecia.map((img) => getImage({ src: img.zdjecie, ...SHARE })),
]);
const shareUrls = share.map((img) => new URL(img.src, SITE_URL).href);

const crumbs = [
  { label: nav.shop, href: '/sklep/' },
  ...(kategoria ? [{ label: kategoria.data.nazwa, href: urlKategorii(kategoria) }] : []),
  { label: p.nazwa, href: urlProduktu(produkt) },
];
---
<Base
  title={p.seo?.tytul ?? p.nazwa}
  description={p.seo?.opis ?? p.krotkiOpis}
  type="product"
  image={shareUrls[0]}
  jsonLd={productJsonLd(produkt, { kategoria, ustawienia: u, images: shareUrls })}
>
  <div class="container section--tight">
    <Breadcrumbs items={crumbs} />
    <div class="split split--top" style="--split: 1.15fr 1fr">
      <ProductGallery zdjecia={p.zdjecia} />

      <div class="info">
        <h1 class="title">{p.nazwa}</h1>
        <Price produkt={p} size="lg" />
        {p.cenaPromocyjna !== undefined && p.najnizszaCena30dni !== undefined && (
          <p class="note">{fill(t.omnibus, { price: formatZl(p.najnizszaCena30dni) })}</p>
        )}
        <p class="t-lead">{p.krotkiOpis}</p>
        {s?.wymiary && <p class="dims"><span class="t-muted">{t.dimensions}:</span> {s.wymiary}</p>}

        <button
          class="btn btn--block btn--lg"
          type="button"
          data-add-to-cart
          data-id={produkt.id}
          data-name={p.nazwa}
          data-price={toGrosze(cenaAktualna(p))}
          data-max={p.stan}
          data-img={miniatura.src}
          data-url={urlProduktu(produkt)}
          disabled={!kupno}
        >
          {kupno ? t.addToCart : status[p.status]}
        </button>
        <p class="note center">{wysylka}</p>
        {kupno && p.stan <= 3 && <p class="note center">{fill(t.lowStock, { n: p.stan })}</p>}

        {p.opis && <div class="desc">{paras(p.opis).map((para) => <p>{para}</p>)}</div>}

        {specs.length > 0 && <dl class="specs">{specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}

        <div class="accs">
          <Accordion title={t.careTitle}>{t.care.map((c) => <p>{c}</p>)}</Accordion>
          <Accordion title={t.safetyTitle}>
            {p.bezpieczenstwo?.split('\n').map((l) => <p>{l}</p>)}
            <p>{t.safety}</p>
            {u.producent?.nazwa && (
              <p>
                {fill(t.producer, { name: u.producent.nazwa })}
                {u.producent.adres && <><br />{u.producent.adres}</>}
                {u.producent.kontakt && <><br />{u.producent.kontakt}</>}
              </p>
            )}
          </Accordion>
          <Accordion title={t.deliveryTitle}>
            <p>
              {fill(t.delivery, { price: u.wysylkaPaczkomat ? ` - ${formatZl(u.wysylkaPaczkomat)}` : '' })}
              {u.darmowaWysylkaOd !== undefined && fill(t.deliveryFree, { price: formatZl(u.darmowaWysylkaOd) })}
              {t.withdrawal}<a href="/dostawa-i-zwroty/">{t.deliveryLink}</a>
            </p>
          </Accordion>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  @media (min-width: 56rem) { .info { position: sticky; top: var(--sp-5); } }
  .title { margin-bottom: var(--sp-3); }
  .note { font-size: var(--fs-sm); color: var(--c-text-muted); margin-bottom: var(--sp-2); }
  .center { text-align: center; max-width: none; }
  .t-lead { margin-block: var(--sp-4); }
  .dims { margin-bottom: var(--sp-5); }
  .btn + .note { margin-top: var(--sp-3); }
  .desc { margin-top: var(--sp-6); }
  .specs { display: grid; margin: var(--sp-6) 0; border-top: 1px solid var(--c-border); }
  .specs div { display: grid; grid-template-columns: 9rem 1fr; gap: var(--sp-4); padding-block: var(--sp-3); border-bottom: 1px solid var(--c-border); font-size: var(--fs-sm); }
  dt { color: var(--c-text-muted); }
  dd { margin: 0; }
  .accs { margin-top: var(--sp-6); }
</style>
