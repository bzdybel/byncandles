---
import Base from '../layouts/Base.astro';
import { common, notFound } from '../i18n/pl';
---
<Base title={notFound.metaTitle} noindex>
  <section class="container section">
    <span class="overline">{notFound.overline}</span>
    <h1>{notFound.title} <em>{notFound.titleEm}</em></h1>
    <p class="t-lead">{notFound.lead}</p>
    <div class="actions">
      <a class="btn btn--lg" href="/sklep/">{common.goToShop}</a>
      <a class="btn btn--ghost btn--lg" href="/">{notFound.home}</a>
    </div>
  </section>
</Base>
<style>
  .actions { margin-top: var(--sp-6); }
</style>
