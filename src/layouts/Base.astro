---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import type { Props as SeoProps } from '../components/Seo.astro';
import { common } from '../i18n/pl';
import { shopConfig } from '../lib/shop';
import { SITE } from '../lib/site';

export type Props = SeoProps;
const config = await shopConfig();
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-display" preload={[{ subset: 'latin', weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-body" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-script" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-logo" preload={[{ subset: 'latin', style: 'italic' }]} />
    <script is:inline>
      // Animacje pojawiania się - tylko z JS i bez „ogranicz ruch” (inaczej treść jest od razu widoczna).
      // Intro strony głównej (.js-intro) - tylko przy pierwszym wejściu w sesji, żeby nie męczyło przy powrotach.
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
        try { if (location.pathname === '/' && !sessionStorage.getItem('intro')) { document.documentElement.classList.add('js-intro'); sessionStorage.setItem('intro', '1'); } } catch {}
      }
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{common.skipLink}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <script type="application/json" id="shop-config" set:html={JSON.stringify(config)} />
    <script>
      if (document.documentElement.classList.contains('js-reveal')) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -12% 0px' });
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
