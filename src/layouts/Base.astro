---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import type { Props as SeoProps } from '../components/Seo.astro';
import { common } from '../i18n/pl';
import { shopConfig } from '../lib/shop';
import { SITE } from '../lib/site';

export type Props = SeoProps;
const config = await shopConfig();
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-display" preload={[{ subset: 'latin', style: 'normal' }]} />
    <Font cssVariable="--font-body" preload={[{ subset: 'latin' }]} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{common.skipLink}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <script type="application/json" id="shop-config" set:html={JSON.stringify(config)} />
  </body>
</html>
