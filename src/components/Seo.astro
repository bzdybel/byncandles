---
import { brand } from '../i18n/pl';
import { NOINDEX_PATHS, SITE } from '../lib/site';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = brand.description, image, type = 'website', jsonLd } = Astro.props;
const noindex = Astro.props.noindex || NOINDEX_PATHS.includes(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === brand.name ? title : `${title} | ${brand.name}`;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={brand.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

{ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...item })} />)}
