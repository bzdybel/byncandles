---
/**
 * Galeria na stronie produktu: jedno zdjęcie - sam kadr; kilka - karuzela (przesuwanie palcem,
 * strzałki, kropki), zawsze jedno zdjęcie naraz, na każdej szerokości ekranu.
 */
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import { product as t } from '../i18n/pl';
import { fill } from '../lib/i18n';

interface Props { zdjecia: { zdjecie: ImageMetadata; alt: string }[] }
const { zdjecia } = Astro.props;
const multi = zdjecia.length > 1;
const sizes = '(min-width: 56rem) 55vw, 92vw';
---
{multi ? (
  <div class="pg" data-gallery role="region" aria-roledescription="karuzela" aria-label={t.gallery}>
    <ul class="track" role="list" data-track tabindex="0">
      {zdjecia.map((img, i) => (
        <li class="frame frame--portrait" aria-roledescription="slajd" aria-label={fill(t.gallerySlide, { n: i + 1, total: zdjecia.length })}>
          <Img src={img.zdjecie} alt={img.alt} widths={[480, 720, 960, 1280]} sizes={sizes} eager={i === 0} />
        </li>
      ))}
    </ul>
    <button class="nav-btn prev" type="button" aria-label={t.galleryPrev} data-dir="-1" disabled>
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button class="nav-btn next" type="button" aria-label={t.galleryNext} data-dir="1">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 5l7 7-7 7" /></svg>
    </button>
    <div class="dots">
      {zdjecia.map((_, i) => (
        <button type="button" class="dot" data-dot={i} aria-label={fill(t.gallerySlide, { n: i + 1, total: zdjecia.length })} aria-current={i === 0 ? 'true' : undefined}></button>
      ))}
    </div>
  </div>
) : (
  <div class="frame frame--portrait" aria-label={t.gallery}>
    <Img src={zdjecia[0].zdjecie} alt={zdjecia[0].alt} widths={[480, 720, 960, 1280]} sizes={sizes} eager />
  </div>
)}

<style>
  .pg { position: relative; }
  .track {
    list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: 100%;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain;
    border-radius: var(--r-md);
  }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 3px; }
  @media (prefers-reduced-motion: no-preference) { .track { scroll-behavior: smooth; } }
  .track li { scroll-snap-align: start; scroll-snap-stop: always; }

  .nav-btn {
    position: absolute; translate: 0 -50%; z-index: 1; display: grid; place-items: center;
    width: var(--tap); height: var(--tap); border: 0; border-radius: var(--r-pill); cursor: pointer;
    background: var(--c-surface); color: var(--c-text); box-shadow: var(--e-2);
    transition: opacity var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .nav-btn:hover { background: var(--c-ink); color: var(--c-on-ink); }
  .nav-btn:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 2px; }
  .nav-btn:disabled { opacity: 0; pointer-events: none; }
  /* Strzałki w połowie wysokości zdjęcia (kropki pod spodem nie przesuwają środka). */
  .nav-btn { top: calc(50% - (var(--tap) + var(--sp-3)) / 2); }
  .prev { left: var(--sp-3); }
  .next { right: var(--sp-3); }

  .dots { display: flex; justify-content: center; gap: var(--sp-1); margin-top: var(--sp-3); }
  .dot {
    width: var(--tap); height: var(--tap); padding: 0; border: 0; background: none; cursor: pointer;
    display: grid; place-items: center;
  }
  .dot::before {
    content: ''; width: 8px; height: 8px; border-radius: 50%;
    background: color-mix(in srgb, var(--c-text) 25%, transparent); transition: background var(--t-fast) var(--ease), scale var(--t-fast) var(--ease);
  }
  .dot[aria-current='true']::before { background: var(--c-text); scale: 1.25; }
  .dot:focus-visible { outline: 2px solid var(--c-accent); outline-offset: -8px; border-radius: 50%; }
</style>

<script>
  // Karuzela zdjęć produktu: strzałki i kropki przewijają o jedno zdjęcie; stan liczony z pozycji przewinięcia,
  // więc zgadza się też przy przesuwaniu palcem. Strzałki w lewo/prawo działają po kliknięciu w zdjęcia.
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = track.children.length;
    const [prev, next] = root.querySelectorAll<HTMLButtonElement>('[data-dir]');
    const dots = root.querySelectorAll<HTMLButtonElement>('[data-dot]');
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => track.scrollTo({ left: Math.max(0, Math.min(slides - 1, i)) * track.clientWidth });

    const update = () => {
      const i = current();
      prev.disabled = i <= 0;
      next.disabled = i >= slides - 1;
      dots.forEach((d, n) => (n === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };

    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.dot))));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault();
        go(current() + (e.key === 'ArrowRight' ? 1 : -1));
      }
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
