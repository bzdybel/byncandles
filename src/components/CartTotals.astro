---
/** Tabela sum koszyka — jedna dla panelu koszyka i strony zamówienia. Wypełniana przez renderTotals(). */
import { cart } from '../i18n/pl';
interface Props { shippingLabel?: string; totalLabel?: string }
const { shippingLabel = cart.shipping, totalLabel = cart.total } = Astro.props;
---
<dl class="totals">
  <div><dt>{cart.subtotal}</dt><dd data-t="subtotal">&nbsp;</dd></div>
  <div class="discount" data-row="discount" hidden><dt>{cart.discount}</dt><dd data-t="discount"></dd></div>
  <div><dt>{shippingLabel}</dt><dd data-t="shipping">&nbsp;</dd></div>
  <div class="grand"><dt>{totalLabel}</dt><dd data-t="total">&nbsp;</dd></div>
</dl>

<style>
  .totals { margin: 0; display: grid; gap: var(--sp-1); font-size: var(--fs-sm); }
  .totals div { display: flex; justify-content: space-between; gap: var(--sp-4); }
  dt { color: var(--c-text-muted); }
  dd { margin: 0; font-variant-numeric: tabular-nums; }
  .discount dd { color: var(--c-success); }
  .grand { margin-top: var(--sp-2); padding-top: var(--sp-2); border-top: 1px solid var(--c-border); font-size: var(--fs-base); }
  .grand dt { color: var(--c-text); }
  .grand dd { font-weight: 500; }
</style>
