---
/** Nagłówek w stylu inspiracji: grafitowy pasek (menu + ikony), pod nim wyśrodkowane logo pismem odręcznym. */
import Logo from './Logo.astro';
import { brand, cart, common, nav } from '../i18n/pl';
import { fill } from '../lib/i18n';
import { NAV, SITE } from '../lib/site';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="topbar">
    <div class="container bar">
      <nav aria-label={nav.label}>
        <ul>
          {NAV.map((item) => (
            <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="icons">
        <a href={SITE.instagram} class="icon-btn" rel="me noopener" target="_blank" aria-label={common.openInstagram}>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
            <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
          </svg>
        </a>
        <a href="/zamowienie/" class="icon-btn cart" data-cart-open aria-label={cart.open}>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="M5 8h14l-1.2 11.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 8Z" /><path d="M9 10V6.5a3 3 0 0 1 6 0V10" />
          </svg>
          <span class="count" data-cart-count hidden>0</span>
        </a>
      </div>
    </div>
  </div>
  <div class="brandbar">
    <a href="/" class="home" aria-label={fill(brand.homeLabel, { name: brand.name })}><Logo /></a>
  </div>
</header>

<style>
  .topbar { background: var(--c-ink); color: var(--c-on-ink); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); min-height: 3rem; }
  ul { display: flex; gap: clamp(var(--sp-1), 2.5vw, var(--sp-6)); list-style: none; margin: 0; padding: 0; }
  nav a {
    display: inline-flex; align-items: center; min-height: var(--tap); padding-inline: var(--sp-2);
    text-decoration: none; font-size: var(--fs-xs); letter-spacing: var(--tracking-overline); text-transform: uppercase;
    background: linear-gradient(currentColor, currentColor) no-repeat left calc(50% + 0.9em) / 0 1px;
    transition: background-size var(--t-base) var(--ease);
  }
  nav a:hover { color: var(--c-on-ink); }
  nav a:hover, nav a[aria-current='page'] { background-size: 100% 1px; }
  .icons { display: flex; margin-right: calc(-1 * var(--sp-2)); }
  .icon-btn:hover { background: rgb(255 255 255 / 0.1); color: var(--c-on-ink); }
  .count {
    position: absolute; top: var(--sp-1); right: 2px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: var(--r-pill);
    background: var(--c-blush); color: var(--c-text); font-size: var(--fs-2xs); line-height: 18px; text-align: center; font-variant-numeric: tabular-nums;
  }
  .brandbar { display: flex; justify-content: center; padding-block: var(--sp-4) var(--sp-3); border-bottom: 1px solid var(--c-border); }
  .home { text-decoration: none; display: inline-flex; min-height: var(--tap); align-items: center; }
  @media (max-width: 30rem) { nav a { padding-inline: var(--sp-1); letter-spacing: var(--tracking-button); } }
</style>
