---
/** Znak słowny „— by N. candles —” kursywą Bodoni Moda. Do podmiany na oryginalny plik SVG logo. */
import { brand } from '../i18n/pl';
---
<span class="logo" aria-hidden="true">{brand.name}</span>

<style>
  .logo {
    display: inline-flex; align-items: center; gap: 0.45em;
    font-family: var(--f-logo); font-style: italic; font-weight: 500; font-size: clamp(1.75rem, 1.5rem + 1.1vw, 2.375rem); line-height: 1; letter-spacing: -0.01em; color: var(--c-text); white-space: nowrap;
  }
  .logo::before, .logo::after { content: ''; width: 0.55em; height: 1px; background: currentColor; opacity: 0.6; }
</style>
