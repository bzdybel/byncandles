---
/** Znak słowny „— by N. candles —” pismem odręcznym, jak w inspiracjach („- Lara Designs -”). Do podmiany na oryginalny plik SVG logo. */
import { brand } from '../i18n/pl';
---
<span class="logo" aria-hidden="true">{brand.name}</span>

<style>
  .logo {
    display: inline-flex; align-items: center; gap: 0.45em;
    font-family: var(--f-script); font-size: clamp(2.25rem, 1.9rem + 1.4vw, 3rem); line-height: 1; color: var(--c-text); white-space: nowrap;
  }
  .logo::before, .logo::after { content: ''; width: 0.55em; height: 1px; background: currentColor; opacity: 0.6; }
</style>
