---
/** Zwijana sekcja na bazie <details> - działa bez JS, dostępna z klawiatury. */
interface Props { title: string; open?: boolean }
const { title, open = false } = Astro.props;
---
<details class="acc" open={open}>
  <summary><span>{title}</span><span class="icon" aria-hidden="true"></span></summary>
  <div class="body"><slot /></div>
</details>

<style>
  .acc { border-top: 1px solid var(--c-border); }
  .acc:last-of-type { border-bottom: 1px solid var(--c-border); }
  summary {
    list-style: none; display: flex; justify-content: space-between; align-items: center; gap: var(--sp-4);
    min-height: 3.5rem; cursor: pointer; font-size: var(--fs-sm); letter-spacing: 0.06em;
    transition: color var(--t-fast) var(--ease);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--c-accent); }
  .icon { position: relative; width: 12px; height: 12px; flex: none; }
  .icon::before, .icon::after { content: ''; position: absolute; inset: 50% 0 auto; height: 1px; background: currentColor; transition: transform var(--t-base) var(--ease); }
  .icon::after { transform: rotate(90deg); }
  .acc[open] .icon::after { transform: rotate(0deg); }
  .body { padding-bottom: var(--sp-5); font-size: var(--fs-sm); color: var(--c-text-muted); }
  .body :global(p) { margin-bottom: var(--sp-3); }
</style>
