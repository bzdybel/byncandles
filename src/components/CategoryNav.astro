---
import { shop } from '../i18n/pl';
import { urlKategorii, type Kategoria } from '../lib/shop';
interface Props { kategorie: Kategoria[] }
const { kategorie } = Astro.props;
const path = Astro.url.pathname;
const links = [{ href: '/sklep/', label: shop.all }, ...kategorie.map((k) => ({ href: urlKategorii(k), label: k.data.nazwa }))];
---
{kategorie.length > 1 && (
  <nav aria-label={shop.categories}>
    <ul>{links.map((l) => <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>)}</ul>
  </nav>
)}

<style>
  ul { list-style: none; padding: 0; margin: 0 0 var(--sp-6); display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  a {
    display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 var(--sp-5); border: 1px solid var(--c-border);
    border-radius: var(--r-pill); text-decoration: none; font-size: var(--fs-xs); letter-spacing: var(--tracking-button); text-transform: uppercase;
  }
  a:hover { border-color: var(--c-text); }
  a[aria-current='page'] { background: var(--c-text); border-color: var(--c-text); color: var(--c-surface); }
</style>
