---
import CartTotals from './CartTotals.astro';
import { cart, common } from '../i18n/pl';
import { shopConfig } from '../lib/shop';
const cfg = await shopConfig();
---
<dialog id="cart" class="drawer" aria-labelledby="cart-title">
  <div class="panel">
    <header class="top">
      <h2 id="cart-title" class="title">{cart.title}</h2>
      <button type="button" class="icon-btn" data-cart-close aria-label={cart.close}>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.2" fill="none" /></svg>
      </button>
    </header>

    {cfg.promo2plus1 && <p class="promo-bar">{cart.promoBar}</p>}
    <p class="notice" data-cart-notice hidden>{cart.updated}</p>

    <div class="body">
      <ul class="items" role="list" data-cart-items></ul>
      <div class="empty" data-cart-empty hidden>
        <p class="t-lead">{cart.emptyLead}</p>
        <p class="t-muted">{cart.emptyText}</p>
        <a class="btn" href="/sklep/">{common.goToShop}</a>
      </div>
    </div>

    <footer class="summary" data-cart-summary hidden>
      {cfg.freeFrom !== undefined && (
        <div class="free">
          <p class="t-small" data-cart-free-text></p>
          <div class="bar" aria-hidden="true"><span data-cart-free-bar></span></div>
        </div>
      )}
      <CartTotals />
      <a class="btn btn--block btn--lg" href="/zamowienie/">{cart.checkout}</a>
      <button type="button" class="link-btn" data-cart-close>{cart.continue}</button>
    </footer>
  </div>
</dialog>

<p class="visually-hidden" aria-live="polite" data-cart-live></p>

<template id="cart-item-tpl">
  <li class="item">
    <a class="thumb" data-href tabindex="-1" aria-hidden="true"><img alt="" width="72" height="90" loading="lazy" data-img /></a>
    <div class="info">
      <a class="name" data-href data-name></a>
      <span class="t-small t-muted" data-price></span>
      <div class="row">
        <div class="stepper" role="group">
          <button type="button" data-dec aria-label={cart.decrease}>−</button>
          <span data-qty></span>
          <button type="button" data-inc aria-label={cart.increase}>+</button>
        </div>
        <button type="button" class="link-btn" data-remove>{cart.remove}</button>
      </div>
      <span class="t-small t-muted" data-limit hidden>{cart.limit}</span>
    </div>
    <span class="line" data-line></span>
  </li>
</template>

<script>
  import { cart as t } from '../i18n/pl';
  import { fill } from '../lib/i18n';
  import { formatGrosze } from '../lib/money';
  import { totals } from '../lib/pricing';
  import { add, CHANGE_EVENT, onExternalChange, read, readConfig, remove, setQty, sync, UPDATED_EVENT } from '../scripts/cart-store';
  import { announce, renderCount, renderTotals } from '../scripts/cart-ui';

  const dialog = document.getElementById('cart') as HTMLDialogElement;
  const tpl = document.getElementById('cart-item-tpl') as HTMLTemplateElement;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = dialog) => root.querySelector<T>(sel)!;
  const cfg = readConfig();
  let returnFocus: HTMLElement | null = null;

  function open(trigger: HTMLElement) {
    returnFocus = trigger;
    if (!dialog.open) dialog.showModal();
    void sync();
  }

  function close() {
    dialog.classList.add('closing');
    setTimeout(() => {
      dialog.classList.remove('closing');
      dialog.close();
      returnFocus?.focus();
    }, 200);
  }

  function itemNode(i: ReturnType<typeof read>[number]): HTMLElement {
    const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    li.querySelectorAll<HTMLAnchorElement>('[data-href]').forEach((a) => (a.href = i.url));
    const img = $<HTMLImageElement>('[data-img]', li);
    if (i.img) img.src = i.img;
    else img.remove();
    $('[data-name]', li).textContent = i.name;
    $('[data-price]', li).textContent = fill(t.perUnit, { price: formatGrosze(i.price) });
    $('[data-qty]', li).textContent = String(i.qty);
    $('[data-line]', li).textContent = formatGrosze(i.price * i.qty);
    $('.stepper', li).setAttribute('aria-label', fill(t.qtyGroup, { name: i.name }));
    const inc = $<HTMLButtonElement>('[data-inc]', li);
    inc.disabled = i.qty >= i.max;
    $('[data-limit]', li).hidden = i.qty < i.max;
    inc.onclick = () => setQty(i.id, i.qty + 1);
    $<HTMLButtonElement>('[data-dec]', li).onclick = () => setQty(i.id, i.qty - 1);
    $<HTMLButtonElement>('[data-remove]', li).onclick = () => {
      remove(i.id);
      announce(fill(t.removedLive, { name: i.name }));
    };
    return li;
  }

  function render() {
    const items = read();
    const sum = totals(items, cfg);
    $('[data-cart-items]').replaceChildren(...items.map(itemNode));
    $('[data-cart-empty]').hidden = items.length > 0;
    $('[data-cart-summary]').hidden = items.length === 0;
    renderTotals(dialog, sum);
    renderCount(sum.count);
    if (sum.freeProgress !== undefined) {
      $('[data-cart-free-text]').textContent = sum.missingForFree ? fill(t.freeMissing, { price: formatGrosze(sum.missingForFree) }) : t.freeReached;
      $('[data-cart-free-bar]').style.width = `${sum.freeProgress * 100}%`;
    }
  }

  function onAdd(btn: HTMLButtonElement) {
    const d = btn.dataset;
    const label = btn.textContent;
    const ok = add({ id: d.id!, name: d.name!, price: Number(d.price), max: Number(d.max), img: d.img, url: d.url! });
    btn.dataset.state = ok ? 'success' : '';
    btn.textContent = ok ? t.added : t.maxReached;
    announce(fill(ok ? t.addedLive : t.maxReachedLive, { name: d.name! }));
    setTimeout(() => {
      btn.dataset.state = '';
      btn.textContent = label;
    }, 1800);
    if (ok) setTimeout(() => open(btn), 350);
  }

  dialog.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target === dialog || target.closest('[data-cart-close]')) close();
  });
  dialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const opener = target.closest<HTMLElement>('[data-cart-open]');
    if (opener) {
      e.preventDefault();
      open(opener);
      return;
    }
    const btn = target.closest<HTMLButtonElement>('[data-add-to-cart]');
    if (btn && !btn.disabled) onAdd(btn);
  });
  document.addEventListener(CHANGE_EVENT, render);
  document.addEventListener(UPDATED_EVENT, () => {
    $('[data-cart-notice]').hidden = false;
    announce(t.updated);
  });
  onExternalChange(render);
  render();
  void sync();
</script>

<style>
  .drawer {
    margin: 0 0 0 auto; padding: 0; border: 0; width: min(28rem, 100%); max-width: 100%; height: 100dvh; max-height: 100dvh;
    background: var(--c-surface); color: var(--c-text); box-shadow: var(--e-2);
  }
  .drawer[open] { animation: slide-in var(--t-slow) var(--ease); }
  .drawer.closing { animation: slide-out var(--t-base) var(--ease) forwards; }
  .drawer::backdrop { background: var(--c-overlay); animation: fade var(--t-slow) var(--ease); }
  @keyframes slide-in { from { transform: translateX(100%); } }
  @keyframes slide-out { to { transform: translateX(100%); } }
  @keyframes fade { from { opacity: 0; } }

  .panel { display: flex; flex-direction: column; height: 100%; }
  .top { display: flex; justify-content: space-between; align-items: center; padding: var(--sp-4) var(--sp-5); border-bottom: 1px solid var(--c-border); }
  .title { font-size: var(--fs-xl); margin: 0; }
  .top .icon-btn { margin-right: calc(-1 * var(--sp-3)); }
  .promo-bar, .notice { margin: 0; max-width: none; padding: var(--sp-2) var(--sp-5); font-size: var(--fs-sm); text-align: center; }
  .promo-bar { background: var(--c-latte); }
  .notice { background: var(--c-surface-alt); }

  .body { flex: 1; overflow-y: auto; padding: var(--sp-2) var(--sp-5); }
  .items { list-style: none; margin: 0; padding: 0; }
  .empty { padding-block: var(--sp-7); text-align: center; display: grid; justify-items: center; gap: var(--sp-2); }

  .item { display: grid; grid-template-columns: var(--thumb-w) 1fr auto; gap: var(--sp-4); padding-block: var(--sp-4); border-bottom: 1px solid var(--c-border); }
  .thumb { display: block; border-radius: var(--r-sm); overflow: hidden; background: var(--c-surface-alt); aspect-ratio: 4 / 5; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .info { display: grid; gap: var(--sp-1); align-content: start; }
  .name { font-family: var(--f-serif); text-decoration: none; line-height: var(--lh-snug); }
  .row { display: flex; align-items: center; gap: var(--sp-4); margin-top: var(--sp-2); }
  .line { font-variant-numeric: tabular-nums; }
  .item .link-btn:hover { color: var(--c-error); }

  .summary { padding: var(--sp-5); border-top: 1px solid var(--c-border); display: grid; gap: var(--sp-3); }
  .free p { margin-bottom: var(--sp-2); }
  .bar { height: var(--sp-1); background: var(--c-border); border-radius: var(--r-pill); overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--c-accent); transition: width var(--t-slow) var(--ease); }
</style>
