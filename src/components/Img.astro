---
/** Responsywne zdjęcie (AVIF/WebP + srcset). `eager` = obraz LCP: bez lazy-load i z wysokim priorytetem. */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { FORMATS } from '../lib/media';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
}
const { src, alt, widths, sizes, eager = false } = Astro.props;
---
<Picture src={src} alt={alt} formats={FORMATS} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
