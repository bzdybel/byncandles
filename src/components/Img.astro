---
/** Responsywne zdjęcie (AVIF/WebP + srcset).
 *  `eager` = obraz LCP: bez lazy-load i z wysokim priorytetem.
 *  `noLazy` = widoczne od razu na dużych ekranach (nad linią zgięcia), ale nie LCP: bez lazy-load, zwykły priorytet. */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { FORMATS } from '../lib/media';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
  noLazy?: boolean;
}
const { src, alt, widths, sizes, eager = false, noLazy = false } = Astro.props;
---
<Picture src={src} alt={alt} formats={FORMATS} widths={widths} sizes={sizes} loading={eager || noLazy ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
