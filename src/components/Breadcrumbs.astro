---
import { SITE_URL } from '../lib/site';
interface Props { items: { label: string; href: string }[] }
const { items } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.label, item: new URL(it.href, SITE_URL).href })),
};
---
<nav aria-label="Okruszki" class="crumbs">
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}</li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<style>
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s-2); margin: 0 0 var(--s-4); padding: 0; font-size: 0.8rem; color: var(--c-muted); }
  .crumbs li + li::before { content: '/'; margin-right: var(--s-2); }
</style>
