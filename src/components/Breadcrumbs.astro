---
import { SITE_URL } from '../lib/site';
interface Props { items: { label: string; href: string }[] }
const { items } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.label, item: new URL(it.href, SITE_URL).href })),
};
---
<nav aria-label="Okruszki" class="crumbs">
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}</li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<style>
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--sp-2); margin: 0 0 var(--sp-5); padding: 0; font-size: var(--fs-xs); letter-spacing: 0.04em; color: var(--c-text-muted); }
  .crumbs li + li::before { content: '/'; margin-right: var(--sp-2); opacity: 0.6; }
  .crumbs a { display: inline-flex; align-items: center; min-height: 24px; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
</style>
