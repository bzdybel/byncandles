---
import ProductCard from './ProductCard.astro';
import type { Produkt } from '../lib/shop';
interface Props { produkty: Produkt[]; eagerFirst?: number }
const { produkty, eagerFirst = 0 } = Astro.props;
---
<ul class="grid" role="list">
  {produkty.map((p, i) => <li><ProductCard produkt={p} eager={i < eagerFirst} /></li>)}
</ul>
<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5) var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); }
</style>
