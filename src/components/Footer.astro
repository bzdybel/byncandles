---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container grid">
    <div class="brand">
      <Logo />
      <p class="t-muted">Ręcznie robione świece z wosku sojowego i pszczelego. Tworzy {SITE.author}.</p>
    </div>
    <nav aria-labelledby="f-shop">
      <p class="overline" id="f-shop">Sklep</p>
      <ul>
        <li><a href="/sklep/">Wszystkie świece</a></li>
        <li><a href="/dostawa-i-zwroty/">Dostawa i zwroty</a></li>
        <li><a href="/kontakt/">Zamówienia indywidualne</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="f-info">
      <p class="overline" id="f-info">Informacje</p>
      <ul>
        <li><a href="/o-mnie/">O mnie</a></li>
        <li><a href="/kontakt/">Kontakt</a></li>
        <li><a href="/regulamin/">Regulamin</a></li>
        <li><a href="/polityka-prywatnosci/">Polityka prywatności</a></li>
      </ul>
    </nav>
    <div>
      <p class="overline">Obserwuj</p>
      <ul><li><a href={SITE.instagram} rel="me noopener" target="_blank">Instagram @by_n.candles</a></li></ul>
    </div>
  </div>
  <p class="container copy">© {year} {SITE.name} · wosk sojowy i pszczeli · rękodzieło</p>
</footer>

<style>
  .site-footer { background: var(--c-surface-alt); padding-block: var(--sp-8) var(--sp-5); margin-top: var(--sp-8); font-size: var(--fs-sm); }
  .grid { display: grid; gap: var(--sp-7) var(--sp-5); grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .brand { display: grid; gap: var(--sp-4); justify-items: start; align-content: start; }
  .overline { margin-bottom: var(--sp-2); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; }
  ul a { display: inline-flex; align-items: center; min-height: var(--tap); text-decoration: none; }
  ul a:hover { text-decoration: underline; }
  @media (min-width: 48rem) { ul a { min-height: 2rem; } }
  .copy { margin-top: var(--sp-7); padding-top: var(--sp-4); border-top: 1px solid var(--c-border); font-size: var(--fs-xs); color: var(--c-text-muted); max-width: none; }
</style>
