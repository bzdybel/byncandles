---
import Logo from './Logo.astro';
import { brand, common, footer } from '../i18n/pl';
import { fill } from '../lib/i18n';
import { SITE } from '../lib/site';

const groups = [
  { id: 'f-shop', title: footer.shop, links: [['/sklep/', footer.allCandles], ['/dostawa-i-zwroty/', footer.delivery], ['/kontakt/', footer.customOrders]] },
  { id: 'f-info', title: footer.info, links: [['/o-mnie/', footer.about], ['/kontakt/', footer.contact], ['/regulamin/', footer.terms], ['/polityka-prywatnosci/', footer.privacy]] },
] as const;
---
<footer class="site-footer">
  <div class="container grid">
    <div class="brand">
      <Logo />
      <p class="t-muted">{fill(footer.intro, { author: brand.author })}</p>
    </div>
    {groups.map((g) => (
      <nav aria-labelledby={g.id}>
        <p class="overline" id={g.id}>{g.title}</p>
        <ul>{g.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>
    ))}
    <div>
      <p class="overline">{footer.follow}</p>
      <ul><li><a href={SITE.instagram} rel="me noopener" target="_blank">{fill(footer.instagram, { handle: common.instagramHandle })}</a></li></ul>
    </div>
  </div>
  <p class="container copy">{fill(footer.copyright, { year: new Date().getFullYear(), name: brand.name, tagline: brand.tagline })}</p>
</footer>

<style>
  .site-footer { background: var(--c-surface-alt); padding-block: var(--sp-8) var(--sp-5); margin-top: var(--sp-8); font-size: var(--fs-sm); }
  .grid { display: grid; gap: var(--sp-7) var(--sp-5); grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .brand { display: grid; gap: var(--sp-4); justify-items: start; align-content: start; }
  .overline { margin-bottom: var(--sp-2); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; }
  ul a { display: inline-flex; align-items: center; min-height: var(--tap); text-decoration: none; }
  ul a:hover { text-decoration: underline; }
  @media (min-width: 48rem) { ul a { min-height: var(--sp-6); } }
  .copy { margin-top: var(--sp-7); padding-top: var(--sp-4); border-top: 1px solid var(--c-border); font-size: var(--fs-xs); color: var(--c-text-muted); max-width: none; }
</style>
